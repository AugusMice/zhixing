# 知星香港服务器 Node.js 生产环境变量
# 复制为 .env 后填写实际密钥，不要把真实 .env 提交到版本库，也不要加 VITE_* 前缀。
# 随机密钥生成命令：openssl rand -base64 32

# Node.js 监听参数（反代模式下建议绑定 127.0.0.1）
HOST=127.0.0.1
PORT=3000

# 知星站点来源与登录回调（与 Nginx 域名、wris-auth 侧 ZHIXING_REDIRECT_URI 保持一致）
ZHIXING_ORIGIN=https://zhistar.aux.wris.me
ZHIXING_REDIRECT_URI=https://zhistar.aux.wris.me/api/auth/callback
ZHIXING_CLIENT_ID=zhixing

# wris.me 中央认证服务与云端数据同步服务
WRIS_AUTH_ORIGIN=https://auth.wris.me
WRIS_BRIDGE_URL=https://auth.wris.me/api/bridge
WRIS_SYNC_URL=https://api.wris.me/zhixing/sync

# 服务端密钥（至少 32 字符，各自独立生成）
ZHIXING_SESSION_SECRET=
ZHIXING_EXCHANGE_SECRET=
ZHIXING_SYNC_SECRET=
